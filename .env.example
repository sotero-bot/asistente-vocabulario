# OpenAI
OPENAI_API_KEY=sk-...

# Postgres — usamos los mismos nombres que Vercel auto-inyecta al integrar Supabase.
# Local: ambas apuntan al mismo Postgres local.
# Vercel: las inyecta automáticamente la integración Supabase (no las añadas manual).
#
# POSTGRES_URL: usado en runtime (pooled en Supabase, directo en local).
# POSTGRES_URL_NON_POOLING: usado por migraciones (DDL no funciona bien sobre PgBouncer).
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/glosarioia
POSTGRES_URL_NON_POOLING=postgresql://postgres:postgres@localhost:5432/glosarioia
