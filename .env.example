# OpenAI
OPENAI_API_KEY=sk-...

# Auth.js (NextAuth v5)
# Secreto para firmar los JWT de sesión. Genera uno con: openssl rand -base64 32
AUTH_SECRET=
# URL pública de la app. Local: http://localhost:3000 — Vercel: https://tu-dominio
AUTH_URL=http://localhost:3000

# Google OAuth (consentimiento "Internal" en Google Cloud → solo cuentas del Workspace)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Microsoft Entra ID (App registration "Single tenant" → solo cuentas de la organización)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/TENANT_ID/v2.0

# Usuario administrador (login por contraseña). Se siembra solo en cada build/deploy.
# ADMIN_USERNAME es opcional (default "admin"). Define ADMIN_PASSWORD para crearlo.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123

# Admins adicionales por email (opcional, separados por coma). El usuario de
# ADMIN_USERNAME ya es admin sin necesidad de listarlo aquí.
ADMIN_EMAILS=

# Postgres — usamos los mismos nombres que Vercel auto-inyecta al integrar Supabase.
# Local: ambas apuntan al mismo Postgres local.
# Vercel: las inyecta automáticamente la integración Supabase (no las añadas manual).
#
# POSTGRES_URL: usado en runtime (pooled en Supabase, directo en local).
# POSTGRES_URL_NON_POOLING: usado por migraciones (DDL no funciona bien sobre PgBouncer).
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/glosarioia
POSTGRES_URL_NON_POOLING=postgresql://postgres:postgres@localhost:5432/glosarioia
